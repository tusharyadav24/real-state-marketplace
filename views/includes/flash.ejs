<% if (success && success.length) { %>
  <div class="row mt-3">
    <div class="col-11 col-md-8 col-lg-6 mx-auto">
      <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 d-flex align-items-center py-3" role="alert">
        <i class="fa-solid fa-circle-check fs-5 me-2 flex-shrink-0"></i>
        <div class="flex-grow-1">
          <%= success %>
        </div>
        <button type="button" class="btn-close shadow-none" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    </div>
  </div>
<% } %>

<% if (error && error.length) { %>
  <div class="row mt-3">
    <div class="col-11 col-md-8 col-lg-6 mx-auto">
      <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 d-flex align-items-center py-3" role="alert">
        <i class="fa-solid fa-circle-exclamation fs-5 me-2 flex-shrink-0"></i>
        <div class="flex-grow-1">
          <%= error %>
        </div>
        <button type="button" class="btn-close shadow-none" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    </div>
  </div>
<% } %>